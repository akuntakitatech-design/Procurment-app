# ============ Database: MariaDB ============
# Di Coolify pakai host INTERNAL MariaDB (lebih cepat), contoh: mysql://mariadb:PASS@xxxxxxxx:3306/default
DATABASE_URL=mysql://mariadb:PASSWORD@host-mariadb:3306/default
DB_NAME=default
# Terapkan database/schema.sql otomatis saat start (idempoten, dilewati jika hash tidak berubah)
DB_AUTO_SCHEMA=true
DATABASE_POOL_SIZE=10

# (Kompatibilitas) Jika DATABASE_URL kosong, backend memakai MongoDB:
# MONGO_URL=mongodb://localhost:27017

# ============ Server / Auth ============
PORT=8000
# Origin frontend untuk CORS (pisahkan koma bila lebih dari satu). Bila frontend Nginx mem-proxy /api
# (satu domain), isi dengan domain frontend juga.
FRONTEND_URL=https://app.domain-anda.com
# CORS_ORIGINS=https://app.domain-anda.com,https://lain.domain.com
# Flag Secure cookie sesi: auto (ikut X-Forwarded-Proto) | true | false
COOKIE_SECURE=auto
# Rahasia JWT — pertahankan nilai lama agar sesi/user lama tetap valid
JWT_SECRET=GANTI_DENGAN_RANDOM_MINIMAL_48_KARAKTER
# Admin awal (hanya dibuat bila belum ada; password user yang sudah ada TIDAK ditimpa)
ADMIN_EMAIL=admin@domain-anda.com
ADMIN_PASSWORD=GANTI_PASSWORD
ALLOW_DEMO_SEED=false
WRITE_TEST_CREDENTIALS=false

# ============ Storage lampiran: Cloudflare R2 (S3-compatible) ============
# STORAGE_DRIVER: s3 (R2/MinIO/S3) | local
STORAGE_DRIVER=s3
R2_ACCOUNT_ID=
# R2_ENDPOINT otomatis dari R2_ACCOUNT_ID; isi manual bila perlu
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=media-procurmentapp
S3_REGION=auto
# Alias lama (MinIO/S3) tetap didukung: S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY, S3_BUCKET
# Storage lokal (bila STORAGE_DRIVER=local) — butuh volume persisten
STORAGE_LOCAL_PATH=/app/data/uploads

# ============ Email (opsional) ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Procurement
SMTP_USE_TLS=true

# ============ Multi-tenant / SaaS (versi KelolaKita) — WAJIB ============
DEFAULT_TENANT_ID=tenant-pt-real
DEFAULT_COMPANY_ID=company-pt-real
DEFAULT_TENANT_SLUG=pt-real
DEFAULT_TENANT_NAME=PT REAL
DEFAULT_TENANT_MAX_USERS=25
ENABLE_PUBLIC_TENANT_REGISTRATION=false
TENANT_TRIAL_DAYS=14
DISABLE_LEGACY_USER_SELF_REGISTER=true
PLATFORM_ADMIN_EMAIL=GANTI_EMAIL_SUPER_ADMIN_PLATFORM
PLATFORM_ADMIN_PASSWORD=GANTI_PASSWORD_KUAT
PLATFORM_ADMIN_NAME=Akuntakita Super Admin
# Batas upload lampiran (MB), default 15
# MAX_UPLOAD_MB=15
# SMTP (opsional) untuk email PO / undangan tenant
# SMTP_HOST= SMTP_PORT=587 SMTP_USERNAME= SMTP_PASSWORD= SMTP_FROM= SMTP_FROM_NAME=Procurement SMTP_USE_TLS=true
