# Copy to .env on the server and replace every CHANGE_ME value.
# Use URL-safe characters for MongoDB credentials unless you URL-encode them.

APP_PORT=8188
PUBLIC_URL=https://app.akuntakita.com
CADDY_NETWORK=02-vps-selfhost_kebun

MONGO_ROOT_USERNAME=procurement_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
DB_NAME=procurement
MONGO_URL=mongodb://procurement_admin:CHANGE_ME_MONGO_PASSWORD@mongodb:27017/procurement?authSource=admin

JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Attachment storage. Local persistent Docker volume is the default for this single-VPS deployment.
STORAGE_DRIVER=local
